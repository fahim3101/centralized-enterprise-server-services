---
config:
  layout: dagre
  look: classic
---
graph TB
    subgraph BRANCHES["BRANCHES — 4 remote sites"]
        direction LR
        subgraph BR1["Branch 1"]
            direction TB
            B1PC["BR1-PC1<br/>192.168.13.x"] --> B1SW["BR1-ACCESS<br/>VLAN 13"]
            B1SW --> B1R["BR1-WAN-RTR"]
        end
        subgraph BR2["Branch 2"]
            direction TB
            B2PC["BR2-PC1<br/>192.168.14.x"] --> B2SW["BR2-ACCESS<br/>VLAN 14"]
            B2SW --> B2R["BR2-WAN-RTR"]
        end
        subgraph BR3["Branch 3"]
            direction TB
            B3PC["BR3-PC1<br/>192.168.15.x"] --> B3SW["BR3-ACCESS<br/>VLAN 15"]
            B3SW --> B3R["BR3-WAN-RTR"]
        end
        subgraph BR4["Branch 4"]
            direction TB
            B4PC["BR4-PC1<br/>192.168.16.x"] --> B4SW["BR4-ACCESS<br/>VLAN 16"]
            B4SW --> B4R["BR4-WAN-RTR"]
        end
    end

    subgraph HQ["HEADQUARTERS"]
        direction LR
        subgraph ACC["Access Layer"]
            direction TB
            AS["access-sales-01<br/>VLAN 10"] --- ASP["SALES-PC1..3"]
            AH["access-hr-01<br/>VLAN 11"] --- AHP["HR-PC1..3"]
            AA["access-accounts-01<br/>VLAN 12"] --- AAP["ACCOUNTS-PC1..3"]
        end
        LF["leaf-01 / leaf-02<br/>LACP interconnect<br/>trunks VLAN 10-12,20"]
        subgraph CORE["Core Layer"]
            direction TB
            CR["core-01 / core-02<br/>HSRP &middot; OSPF area 0<br/>DHCP server"]
        end
        subgraph SRV["Server VLAN 20"]
            direction LR
            S0["Server0 &nbsp;172.10.10.1<br/>HTTP &middot; HTTPS<br/>www.company.com"]
            S1["Server1 &nbsp;172.10.10.2<br/>DNS<br/>homelab.local"]
            S2["Server2 &nbsp;172.10.10.3<br/>SMTP &middot; POP3<br/>mail.company.com"]
        end
        WR["HQ-WAN-RTR<br/>OSPF + IPsec hub"]
        ACC --- LF
        LF --- CORE
        CORE --- SRV
        CORE --- WR
    end

    B1R <-->|"5.1.1.0/24 IPsec"| WR
    B2R <-->|"6.1.1.0/24 IPsec"| WR
    B3R <-->|"7.1.1.0/24 IPsec"| WR
    B4R <-->|"8.1.1.0/24 IPsec"| WR

    CR -->|"10.3.3.0/24"| EDGE["EDGE-RTR<br/>10.3.3.2 &middot; 200.1.1.1<br/>NAT / PAT"]
    EDGE -->|"200.1.1.0/30"| ISP["ISP<br/>200.1.1.2"]
    ISP -->|"203.0.113.0/24"| INT["Server3<br/>203.0.113.10<br/>Internet Server"]

    classDef server fill:#0b3d5c,stroke:#4fc3f7,color:#e8f6ff
    classDef core fill:#124a2c,stroke:#66bb6a,color:#e8ffe8
    classDef branch fill:#4a2d12,stroke:#ffa726,color:#fff3e0
    classDef edge fill:#4a124a,stroke:#ce93d8,color:#f3e5f5
    class S0,S1,S2,INT server
    class CR,LF core
    class B1R,B1SW,B2R,B2SW,B3R,B3SW,B4R,B4SW branch
    class EDGE,ISP edge
